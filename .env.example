# Copie este arquivo para ".env" (sem o .example) e cole sua chave da OpenAI.
# O arquivo .env nunca deve ser compartilhado nem versionado no git.

OPENAI_API_KEY=sk-cole-sua-chave-aqui

# Opcional — porta em que o servidor local roda.
PORT=3000

# Opcional — modelo usado para sugerir a pontuação da rubrica.
# gpt-4o-mini é rápido e barato; troque por gpt-4o ou outro modelo se quiser
# respostas mais elaboradas (custo maior por avaliação).
OPENAI_MODEL=gpt-4o-mini

# Opcional — modelo usado para transcrever o áudio do podcast.
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Obrigatórios quando o aplicativo for hospedado na internet.
APP_USERNAME=professor
APP_PASSWORD=troque-por-uma-senha-forte

# Diretório persistente das turmas. Em Docker, use /app/data.
DATA_DIR=./data
